{
  "name": "celebrate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/pricing.js tests/budget.js tests/api.js tests/workflow.js",
    "dev:site": "concurrently -k -n api,site -c magenta,cyan \"npm run dev:api\" \"vite --config site/vite.config.js\"",
    "dev:live": "vite --config site/vite.config.js --mode live",
    "dev:web:live": "vite --mode live",
    "build:site": "vite build --config site/vite.config.js",
    "start:site": "STATIC_DIR=site/dist NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.1.0",
    "@fontsource/noto-sans": "^5.1.0",
    "@netlify/blobs": "^11.1.9",
    "express": "^4.21.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.462.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "vite": "^5.4.10"
  }
}
